# Backend (Go API). Copy to .env and adjust if needed - config.Load() loads
# this file at startup, then reads these variables; everything else lives in
# config/*.toml. A real exported shell variable always wins over a value here
# (PORT=9090 make dev beats PORT=8080 in .env), and a missing .env is fine.
PORT=8080
MONGO_URI=mongodb://localhost:27017

# APP_ENV selects which config/<env>.toml overlays config/default.toml.
# dev (default) | test
APP_ENV=dev
